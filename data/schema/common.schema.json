{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokergto.dev/schemas/common.schema.json",
  "title": "Shared definitions for every pokergto artifact",
  "description": "This file is the contract that ADR-0001 and ADR-0005 rest on. $ref resolution is performed against a local registry built from data/schema/ by tools/check_artifact_schema.py; the $id URIs above are anchors and are never fetched.",
  "$defs": {
    "lang_string": {
      "description": "A string that must exist in both languages. Bilingual content is a type-level requirement, not a convention: an artifact cannot express a monolingual title.",
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "glossary_ref": {
      "description": "Term id registered in data/src/glossary.yaml. Unknown terms fail CI rather than being silently accepted.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Dotted lowercase identifier with optional hyphenated segments, e.g. spot.6max-co-open-vs-bb, table.02-03.mdf-vs-sizing. Lesson ids use the separate NN-NN pattern."
    },
    "status": {
      "description": "ready requires BOTH languages complete (ADR-0005 / D4) and, for anything citing a solver result, a matching entry in src/pokergto/solver/proofs.py.",
      "enum": ["draft", "in-review", "ready", "deprecated"]
    },
    "provenance_kind": {
      "enum": ["derived", "reference", "external"]
    },
    "confidence": {
      "enum": ["high", "medium", "low"]
    },
    "accepted_license": {
      "description": "Closed list. Proprietary sources (PioSolver, GTO Wizard, GTO+, Upswing, Run It Once, ...) are absent on purpose; adding one requires editing this schema and NOTICE together.",
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "MIT",
        "public-domain-math",
        "fair-use-commentary"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verified", "confidence", "license", "upstream"],
      "properties": {
        "kind": { "$ref": "#/$defs/provenance_kind" },
        "verified": {
          "type": "boolean",
          "default": false,
          "description": "Defaults to false. Only three things set it true: a derivation_ref into theory/** with an executing test, a solver_run whose game is listed in solver/proofs.py, or an external source with a manifest-listed compatible license."
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "license": { "$ref": "#/$defs/accepted_license" },
        "upstream": {
          "type": ["string", "null"],
          "description": "Required non-null when kind is external; must have a record in data/src/licensing_manifest.yaml."
        },
        "derivation_ref": { "type": ["string", "null"] },
        "solver_run": { "type": ["string", "null"] },
        "assumptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/lang_string" },
          "description": "Modeling assumptions stated rather than implied. The multiway MDF formula assumes independent defenders, which card removal makes false in practice."
        },
        "note": { "$ref": "#/$defs/lang_string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "external" } } },
          "then": {
            "required": ["upstream"],
            "properties": { "upstream": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "derived" } } },
          "then": {
            "anyOf": [
              {
                "required": ["derivation_ref"],
                "properties": { "derivation_ref": { "type": "string", "minLength": 5 } }
              },
              {
                "required": ["solver_run"],
                "properties": { "solver_run": { "type": "string", "minLength": 5 } }
              }
            ]
          }
        },
        {
          "if": { "properties": { "verified": { "const": true } } },
          "then": {
            "properties": { "confidence": { "const": "high" } },
            "anyOf": [
              {
                "required": ["derivation_ref"],
                "properties": { "derivation_ref": { "type": "string", "minLength": 5 } }
              },
              {
                "required": ["solver_run"],
                "properties": { "solver_run": { "type": "string", "minLength": 5 } }
              },
              {
                "required": ["upstream"],
                "properties": { "upstream": { "type": "string", "minLength": 5 } }
              }
            ],
            "description": "verified: true must point at something checkable. minLength guards against the null placeholder that is always present for optional refs."
          }
        }
      ]
    },
    "unverified_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "why_unverified", "path_to_verified"],
      "properties": {
        "claim": { "$ref": "#/$defs/lang_string" },
        "why_unverified": { "$ref": "#/$defs/lang_string" },
        "path_to_verified": { "$ref": "#/$defs/lang_string" },
        "blocks_ready_status": { "type": "boolean", "default": false }
      }
    },
    "scenario_tag": {
      "description": "Cash 6-max 100bb, MTT, heads-up/button-vs-big-blind, population-exploitative, or shared theory.",
      "enum": ["cash", "mtt", "hu", "population", "shared"]
    },
    "street_tag": {
      "enum": ["preflop", "flop", "turn", "river", "multi-street", "n-a"]
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario"],
      "properties": {
        "scenario": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenario_tag" }
        },
        "streets": {
          "type": "array",
          "items": { "$ref": "#/$defs/street_tag" }
        },
        "concepts": {
          "type": "array",
          "items": { "$ref": "#/$defs/glossary_ref" }
        }
      }
    },
    "numeric_value": {
      "description": "Numbers in artifacts carry their unit. Both languages render the same value with their own unit convention, which is why a unit drift between zh and en is structurally impossible.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": {
          "enum": [
            "probability",
            "percent",
            "bb",
            "bb_per_100",
            "chips_per_hand",
            "ratio",
            "combos",
            "hands",
            "dimensionless"
          ]
        },
        "display": { "type": "string" },
        "stderr": { "type": "number" }
      }
    },
    "frequency_map": {
      "description": "Hand class -> action frequency in [0,1]. Keys are 169 canonical classes (AA, KK, ..., A2o).",
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "check": {
      "description": "An invariant that was true when this artifact was generated. tools/gen_all.py --check re-runs them: an artifact that stops passing is a bug, not a diff.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pass"],
      "properties": {
        "kind": {
          "enum": [
            "ranges_sum_to_one",
            "frequency_bounds",
            "ev_matches_direct_calculation",
            "exploitability",
            "mdf_equality",
            "bluff_indifference",
            "combo_count",
            "game_value_closed_form",
            "determinism"
          ]
        },
        "value": { "type": ["number", "null"] },
        "threshold": { "type": ["number", "null"] },
        "tol": { "type": ["number", "null"] },
        "pass": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    }
  }
}

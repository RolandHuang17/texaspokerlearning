{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokergto.dev/schemas/range_chart.schema.json",
  "title": "A 13x13 range chart",
  "description": "One chart = one player's frequency-weighted hand distribution for one spot. Combo counts come from the canonical 1326 decomposition and are asserted, never assumed. Orientation is fixed repo-wide by src/pokergto/matrix13.py: rows and columns descend A,K,Q,J,T,9..2; the diagonal is pairs; the upper triangle is suited; the lower triangle is offsuit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "title", "orientation", "rows", "columns",
    "cell_combos", "weights", "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/lang_string" },
    "spot": { "$ref": "common.schema.json#/$defs/id" },
    "player": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
    "street": { "$ref": "common.schema.json#/$defs/street_tag" },
    "sizing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["action", "pot_fraction"],
      "properties": {
        "action": { "enum": ["open", "call", "3bet", "4bet", "5bet", "shove", "bet", "check", "raise", "fold"] },
        "pot_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
      }
    },
    "orientation": {
      "const": "akqjt98765432-desc-diagonal-pairs-upper-suited",
      "description": "A single pinned literal. If orientation ever changes, every consumer must change in the same commit, and that is what this string is for."
    },
    "rows": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "type": "string", "pattern": "^(A|K|Q|J|T|9|8|7|6|5|4|3|2)$" }
    },
    "columns": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "type": "string", "pattern": "^(A|K|Q|J|T|9|8|7|6|5|4|3|2)$" }
    },
    "cell_combos": {
      "description": "Combos per 169 class, canonical: 6 for pairs, 4 for suited, 12 for offsuit. Sum over the full grid must be 1326.",
      "type": "object",
      "additionalProperties": { "type": "integer", "enum": [4, 6, 12] }
    },
    "weights": {
      "description": "Frequency in [0,1] per 169 class. Sparse: an absent key means 0.0.",
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "total_combos": { "type": "number", "minimum": 0, "maximum": 1326 },
    "range_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Weighted combos / 1326 * 100. Generated, so a lesson never states a range width it has not computed."
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "unverified_claims": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/unverified_claim" }
    },
    "checks": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/check" } }
  }
}

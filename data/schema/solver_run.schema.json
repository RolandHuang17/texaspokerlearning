{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokergto.dev/schemas/solver_run.schema.json",
  "title": "A recorded CFR solve",
  "description": "The trainer's observation deck plays these recorded runs instead of solving in the browser (ADR-0004). A run is only citable by a ready lesson if its game appears in src/pokergto/solver/proofs.py (ADR-0002).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "game", "algorithm", "iterations", "seed",
    "exploitability_bb_per_hand", "proof_entry", "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "game": {
      "enum": [
        "kuhn",
        "leduc",
        "toy_1street",
        "toy_2street",
        "ruddy",
        "preflop_1326_hu",
        "preflop_1326_6max",
        "pushfold",
        "multiway_3player_fixed"
      ]
    },
    "game_description": { "$ref": "common.schema.json#/$defs/lang_string" },
    "algorithm": { "enum": ["cfr", "cfr_plus", "linear_cfr"] },
    "iterations": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "description": "Tree spec, bet sizes, abstraction buckets, alternating updates flag."
    },
    "exploitability_bb_per_hand": {
      "type": "number",
      "minimum": 0,
      "description": "(BR_1 + BR_2) / 2 for a two-player zero-sum game, in chips per hand. Convention is stated in every lesson that reads it."
    },
    "exploitability_threshold": { "type": "number", "minimum": 0 },
    "game_value_bb_per_hand": { "type": ["number", "null"] },
    "closed_form_value": { "type": ["number", "null"] },
    "curve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iteration", "exploitability"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 1 },
          "exploitability": { "type": "number", "minimum": 0 },
          "elapsed_seconds": { "type": ["number", "null"] }
        }
      }
    },
    "average_strategy": { "type": ["object", "null"] },
    "timing_seconds": { "type": ["number", "null"], "minimum": 0 },
    "peak_memory_mb": { "type": ["number", "null"], "minimum": 0 },
    "proof_entry": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Key into PUBLISHED_PROOFS in src/pokergto/solver/proofs.py. A run with no matching entry cannot back a ready lesson."
    },
    "determinism_verified": {
      "type": "boolean",
      "description": "True only if a re-run with the same seed produced byte-identical output."
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "checks": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/check" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokergto.dev/schemas/manifest.schema.json",
  "title": "data/gen/manifest.json - the fingerprint of a generated tree",
  "description": "The fingerprint of a generated tree. Content only: no clock, no commit sha, no interpreter version, because those make the manifest a function of the machine rather than the inputs and would break byte-for-byte regeneration across the version matrix. `tools/gen_all.py` prints that provenance to the build log instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_version", "generator", "artifact_count", "files"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "engine_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generator": { "const": "tools/gen_all.py" },
    "artifact_count": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "kind", "bytes"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": {
            "enum": [
              "glossary",
              "curriculum_index",
              "table",
              "range_chart",
              "spot",
              "quiz",
              "hand_example",
              "solver_run",
              "pushfold_matrix",
              "preflop_matrix",
              "board_taxonomy",
              "index"
            ]
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "schema": { "type": ["string", "null"] }
        }
      }
    }
  }
}

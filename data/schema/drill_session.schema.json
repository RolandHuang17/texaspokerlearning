{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokergto.dev/schemas/drill_session.schema.json",
  "title": "A named drill the trainer can start (a recipe over quiz and spot artifacts)",
  "description": "Drill sessions reference artifact ids; they contain no content of their own. That keeps the trainer free of poker logic (ADR-0004) and makes a new drill a data change, not a code change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "kind", "items"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/lang_string" },
    "lesson": { "type": ["string", "null"], "pattern": "^\\d{2}-\\d{2}$" },
    "kind": {
      "enum": ["quiz_mix", "range_paint", "spot_decision", "hand_replay", "pushfold", "srs_review"]
    },
    "scenario": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/scenario_tag" } },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "ref": { "$ref": "common.schema.json#/$defs/id" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "count": { "type": "integer", "minimum": 1, "maximum": 200 },
    "seed": { "type": ["integer", "null"], "description": "Pinned so a shared drill is reproducible and a reported score can be re-derived." },
    "pass_criteria": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "min_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "max_ev_lost_bb_per_100": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
